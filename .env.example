# Copy to .env and fill in the values. .env is gitignored; this file holds names only.

# Seals the session cookie (nuxt-auth-utils). At least 32 characters.
# Changing it signs everyone out.
NUXT_SESSION_PASSWORD=

# Local Postgres in docker-compose.yml. Compose reads these when it creates the
# database, so changing them later needs a fresh volume.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The app, drizzle-kit and the seed connect here:
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>
NUXT_DATABASE_URL=

# The tests drop and recreate this database on every run, so its name must end in _test.
# Same server and credentials as above, e.g. .../<POSTGRES_DB>_test
TEST_DATABASE_URL=
