# Copy to .env on the server (chmod 600) and fill in the values. Names only here.

# The database Compose creates on first start. Changing them later needs a fresh volume.
# Generate the password with `openssl rand -hex 32`: it goes into a connection URL, where
# characters such as @ / : would need escaping, and hex has none.
POSTGRES_USER=kohvioad
POSTGRES_PASSWORD=
POSTGRES_DB=kohvioad

# Seals session cookies (nuxt-auth-utils). `openssl rand -hex 32`. Changing it signs everyone out.
NUXT_SESSION_PASSWORD=

# false until launch: robots.txt disallows everything and every page says noindex.
NUXT_SITE_INDEXABLE=false

# The commit that is running. deploy.sh writes it; leave it empty before the first deploy.
IMAGE_TAG=
