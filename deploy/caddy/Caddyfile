# Caddy gets and renews the TLS certificates itself, as long as the domain points at this
# server and ports 80 and 443 are open. deploy.sh reloads this file after every deploy.

kohvioad.eu {
	encode zstd gzip

	# The app reads request bodies into memory, so no body reaches it that is larger than its
	# route needs. The app has the same caps (server/features/security/bodyLimits.ts): these
	# stop an oversized body before it crosses to the app at all. A route that takes an upload
	# gets its own matcher here and a row there; everything else gets the small default.
	#
	# The matchers exclude each other, so exactly one cap applies to a request. The admin's
	# photo upload: the handler's own limit is 15 MB.
	@adminImage path_regexp ^/api/admin/coffees/[^/]+/image$
	request_body @adminImage {
		max_size 16MB
	}
	# A user's suggestion with its price-tag photo: the app takes 6 MiB of photo plus the form.
	@suggestionUpload path_regexp ^/api/me/suggestions$
	request_body @suggestionUpload {
		max_size 7MB
	}
	# Everything else sends JSON of a few kilobytes at most (the app's limit is 32 KiB).
	@otherBodies not path_regexp ^(/api/admin/coffees/[^/]+/image|/api/me/suggestions)$
	request_body @otherBodies {
		max_size 64KB
	}

	# Coffee photos, straight from the media volume, which the app writes and Caddy mounts
	# read-only. Every upload gets a new file name, so a photo found here never changes and
	# browsers may keep it for a year. file_server lists no directories unless told to (`browse`).
	handle_path /media/* {
		root * /srv/media

		# The app writes only .webp files here, so nothing else is served: should a bug ever let
		# someone put another file into the volume, it can't be fetched as a page from this
		# origin. `file` also makes the cache header apply to existing files only.
		@photo {
			path *.webp
			file
		}
		header @photo Cache-Control "public, max-age=31536000, immutable"
		# The browser must use the type Caddy sends, never guess one from the bytes.
		header X-Content-Type-Options nosniff
		# A file from here may load nothing and run nothing, even if opened as a page.
		header Content-Security-Policy "default-src 'none'"

		handle @photo {
			file_server
		}
		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy app:3000
	}

	# One JSON line per request on stdout, which Docker rotates. Client IPs are cut to their
	# network prefix (/24 IPv4, /32 IPv6), so no full address is stored (§5). Caddy already
	# redacts the Cookie and Authorization headers.
	log {
		output stdout
		format filter {
			request>remote_ip ip_mask 24 32
			request>client_ip ip_mask 24 32
			request>headers>X-Forwarded-For delete
		}
	}
}

www.kohvioad.eu {
	redir https://kohvioad.eu{uri} permanent
}
