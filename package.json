    "pg": "^8.23.1",
    "reka-ui": "^2.10.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/eslint": "^1.17.0",
